# development | production. In production the server refuses to start unless
# every variable below is set and JWT_SECRET is at least 32 characters.
NODE_ENV=development

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/hiring_app?schema=public"
JWT_SECRET="change-this-to-a-long-random-string-of-at-least-32-chars"
PORT=4000

# Firebase Admin SDK key for the project in lib/firebase_options.dart
# (Firebase Console > Project settings > Service accounts > Generate new private key).
# Used only to mint the custom token the app signs into Firebase Auth with,
# and to send FCM push notifications. Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# OTP emails (signup verification + password reset) go out through Resend
# (https://resend.com). RESEND_FROM_EMAIL must be on a domain verified in the
# Resend dashboard, or `onboarding@resend.dev` while testing (that sender can
# only deliver to the Resend account owner's own inbox).
# While these are empty (local dev only) the code is logged and returned to
# the app, which shows it on screen instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=GlideRecruit

# TESTING ONLY. In production, set to true to show the OTP in the app when
# Resend refuses the send because the test sender can't reach that address.
# While on, anyone can sign up with an email they don't own. Remove it once a
# sending domain is verified in Resend.
OTP_DEV_FALLBACK=

# Comma-separated browser origins allowed to call the API (the web build's
# URL). Mobile apps send no Origin header and are unaffected. Required in
# production; any origin is allowed when unset.
CORS_ORIGIN=

# Set to true to turn off the "task due soon" reminder push (e.g. when
# running a second server instance that shouldn't send reminders).
DISABLE_TASK_REMINDERS=

# Per-IP request limits (defaults shown). Auth routes: per 15 minutes; the
# rest of the API: per minute.
AUTH_RATE_LIMIT=30
API_RATE_LIMIT=300
