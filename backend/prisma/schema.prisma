generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  candidate
  recruiter
}

enum OpportunityStatus {
  applied
  shortlisted
  taskAssigned
  taskSubmitted
  interviewScheduled
  offered
  rejected
  hired
  /// The candidate withdrew the application or declined the offer.
  withdrawn
}

/// Where one assessment task stands. `assigned` also covers "recruiter asked
/// for changes" (feedback is filled in); `approved` is what unlocks
/// scheduling the interview.
enum TaskStatus {
  assigned
  submitted
  approved
  rejected
}

enum SwipeState {
  wishlist
  shortlist
  rejected
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(candidate)
  company            String   @default("")
  designation        String   @default("")
  phone              String   @default("")
  profileComplete    Boolean  @default(false)
  emailVerified      Boolean  @default(false)
  fcmToken           String?
  /// Important updates (task assigned, interview scheduled, offer...) are
  /// also emailed unless the person turns this off.
  emailNotifications Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  candidateProfile         CandidateProfile?
  companyProfile           Company?
  notifications            Notification[]
  taskTemplates            TaskTemplate[]
  jobPostings              JobPosting[]
  opportunitiesAsCandidate Opportunity[]     @relation("OpportunityCandidate")
  opportunitiesAsRecruiter Opportunity[]     @relation("OpportunityRecruiter")
  messages                 Message[]
  savedJobs                SavedJob[]
  swipes                   Swipe[]           @relation("SwipeRecruiter")
  swipedBy                 Swipe[]           @relation("SwipeCandidate")

  // Phase 2/3 (website parity): per-job swipes, wishlist, pair chat,
  // slot-based interviews, take-home tasks, saved searches, payments.
  candidateSwipesAsRecruiter CandidateSwipe[] @relation("CSwipeRecruiter")
  candidateSwipesAsCandidate CandidateSwipe[] @relation("CSwipeCandidate")
  wishlistAsRecruiter        WishlistEntry[]  @relation("WishRecruiter")
  wishlistAsCandidate        WishlistEntry[]  @relation("WishCandidate")
  chatsAsCompany             ChatMessage[]    @relation("ChatCompany")
  chatsAsCandidate           ChatMessage[]    @relation("ChatCandidate")
  chatsSent                  ChatMessage[]    @relation("ChatSender")
  interviewsAsCompany        Interview[]      @relation("InterviewCompany")
  interviewsAsCandidate      Interview[]      @relation("InterviewCandidate")
  hiringTasksAsCompany       HiringTask[]     @relation("HTaskCompany")
  hiringTasksAsCandidate     HiringTask[]     @relation("HTaskCandidate")
  savedSearches              SavedSearch[]
  payments                   Payment[]

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  purpose   String   @default("signup")
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otp_codes")
}

/// A candidate account's hiring profile -- what recruiters see on the
/// swipe deck. One row per candidate user.
model CandidateProfile {
  userId            String   @id
  age               Int      @default(0)
  qualification     String   @default("")
  experience        String   @default("")
  desiredRole       String   @default("")
  location          String   @default("")
  skills            String[] @default([])
  expectedSalaryLpa Float    @default(0)
  noticePeriod      String   @default("")
  about             String   @default("")
  currentCompany    String   @default("")
  currentSalaryLpa  Float    @default(0)
  photoUrl          String   @default("")
  resumeUrl         String   @default("")
  introVideoUrl     String   @default("")
  /// Lower-cased, trimmed copy of `skills`, for case-insensitive filtering.
  skillsNormalized  String[] @default([])
  /// `experience` ("3 years", "Fresher") as a number, for range filters.
  experienceYears   Float    @default(0)
  /// `noticePeriod` ("30 days", "2 months", "Immediate") in days.
  noticeDays        Int      @default(0)

  // Phase 1 (candidate side). `desiredRole` doubles as the headline /
  // "role looking for"; `experience` stays free text with `experienceYears`
  // derived from it.
  phone                String   @default("")
  /// Never shown on a recruiter-facing card.
  gender               String   @default("")
  degree               String   @default("")
  college              String   @default("")
  graduationYear       Int?
  currentPost          String   @default("")
  expectedSalaryMaxLpa Float?
  salaryNegotiable     Boolean  @default(false)
  workModes            String[] @default([])
  jobTypes             String[] @default([])
  preferredLocations   String[] @default([])
  /// false hides the candidate from every recruiter deck.
  openToWork           Boolean  @default(true)
  /// The "I'm still looking" ring: refreshed by POST /candidates/me/active.
  /// A profile not refreshed for 15 days sinks to the bottom of the deck.
  activeAt             DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([experienceYears])
  @@index([expectedSalaryLpa])
  @@map("candidate_profiles")
}

/// A role a recruiter is hiring for, browsable by every candidate.
model JobPosting {
  id                 String   @id @default(uuid())
  recruiterId        String
  title              String
  description        String   @default("")
  skills             String[] @default([])
  location           String   @default("")
  employmentType     String   @default("")
  salaryMinLpa       Float    @default(0)
  salaryMaxLpa       Float    @default(0)
  /// Minimum years of experience the role asks for (0 = open to freshers).
  minExperienceYears Float    @default(0)
  skillsNormalized   String[] @default([])
  isOpen             Boolean  @default(true)
  /// "open" | "paused" | "closed". `isOpen` is kept equal to status == "open"
  /// so the older routes keep working.
  status             String   @default("open")
  openings           Int      @default(1)
  /// "onsite" | "hybrid" | "remote"
  workMode           String   @default("onsite")
  maxExperienceYears Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  recruiter       User             @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  opportunities   Opportunity[]
  savedBy         SavedJob[]
  candidateSwipes CandidateSwipe[]
  interviews      Interview[]
  hiringTasks     HiringTask[]

  @@index([recruiterId, createdAt])
  @@index([isOpen, createdAt])
  @@map("job_postings")
}

/// One recruiter's hiring interaction with one candidate: status,
/// optional interview slot, optional offer. Created either by the
/// candidate applying to a posting (status "applied") or by the recruiter
/// adding someone from their wishlist / by email.
model Opportunity {
  id               String            @id @default(uuid())
  candidateId      String
  recruiterId      String
  jobPostingId     String?
  role             String            @default("")
  status           OpportunityStatus @default(shortlisted)
  interviewDate    DateTime?
  interviewMode    String            @default("")
  interviewDetails String            @default("")
  offerSalaryLpa   Float?
  offerJoiningDate DateTime?
  offerNotes       String            @default("")

  /// "accepted" | "declined" once the candidate answers the offer.
  offerResponse          String?
  offerRespondedAt       DateTime?
  /// "confirmed" | "reschedule_requested" once the candidate answers the
  /// interview invite; cleared whenever the interview is rescheduled.
  interviewResponse      String?
  interviewResponseNote  String    @default("")
  interviewRespondedAt   DateTime?
  /// 0 = none sent, 1 = the day-before reminder went out, 2 = the hour-before one did.
  interviewRemindersSent Int       @default(0)

  /// When each side last opened the chat; unread = messages newer than this.
  candidateReadAt DateTime?
  recruiterReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate  User        @relation("OpportunityCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  recruiter  User        @relation("OpportunityRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  jobPosting JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  messages   Message[]
  tasks      Task[]

  @@index([candidateId, updatedAt])
  @@index([recruiterId, updatedAt])
  @@index([candidateId, jobPostingId])
  @@map("opportunities")
}

/// Chat thread tied to one opportunity.
model Message {
  id            String   @id @default(uuid())
  opportunityId String
  senderId      String
  text          String
  /// "text" for people typing, "task" / "interview" for the automatic
  /// messages the task and scheduling flow posts into the thread.
  kind          String   @default("text")
  sentAt        DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([opportunityId, sentAt])
  @@map("messages")
}

/// A small assessment a recruiter assigns to a shortlisted candidate: the
/// candidate submits an answer and/or a link, the recruiter reviews it, and
/// only then is the interview scheduled.
model Task {
  id                   String     @id @default(uuid())
  opportunityId        String
  title                String
  description          String     @default("")
  link                 String     @default("")
  dueDate              DateTime?
  status               TaskStatus @default(assigned)
  answer               String     @default("")
  submissionLink       String     @default("")
  submittedAt          DateTime?
  /// A file the candidate attached (Cloudinary link) and its original name.
  submissionFileUrl    String     @default("")
  submissionFileName   String     @default("")
  feedback             String     @default("")
  reviewedAt           DateTime?
  /// Set once the "due soon" reminder push has gone out, so it never repeats.
  reminderSentAt       DateTime?
  /// Set once the recruiter was nudged about a submission waiting for review.
  reviewReminderSentAt DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("tasks")
}

/// A candidate's bookmarked job postings.
model SavedJob {
  candidateId  String
  jobPostingId String
  savedAt      DateTime @default(now())

  candidate  User       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@id([candidateId, jobPostingId])
  @@map("saved_jobs")
}

/// A recruiter's decision on a candidate from the swipe deck: wishlist,
/// shortlist (promoted from wishlist) or rejected (passed). Any row at all
/// means "already swiped", so the deck never shows that candidate again.
model Swipe {
  recruiterId String
  candidateId String
  state       SwipeState
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  recruiter User @relation("SwipeRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate User @relation("SwipeCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([recruiterId, candidateId])
  @@index([recruiterId, state])
  @@map("swipes")
}

/// A task the recruiter saved to reuse with other candidates.
model TaskTemplate {
  id          String   @id @default(uuid())
  recruiterId String
  title       String
  description String   @default("")
  link        String   @default("")
  createdAt   DateTime @default(now())

  recruiter User @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([recruiterId, createdAt])
  @@map("task_templates")
}

/// The in-app inbox: every event that was also pushed, kept so it can be
/// read later and marked as read.
model Notification {
  id            String    @id @default(uuid())
  userId        String
  type          String    @default("info")
  title         String
  body          String    @default("")
  opportunityId String?
  /// In-app route this notification opens (e.g. "/messages?with=<id>").
  link          String    @default("")
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// A recruiter's company page. `verificationStatus` is "unverified",
/// "pending" (manual review requested) or "verified"; a company whose
/// website domain matches the owner's (already OTP-verified) email domain is
/// verified automatically.
model Company {
  id                 String    @id @default(uuid())
  ownerId            String    @unique
  name               String
  website            String    @default("")
  about              String    @default("")
  industry           String    @default("")
  size               String    @default("")
  location           String    @default("")
  logoUrl            String    @default("")
  verificationStatus String    @default("unverified")
  verificationNote   String    @default("")
  verifiedAt         DateTime?
  /// Swipe credits: every swipe (left or right) costs one; wishlisting is free.
  swipesLeft         Int       @default(5)
  swipesPurchased    Int       @default(0)
  /// Payment order ids already credited, so a webhook and a verify call can
  /// never credit the same order twice.
  creditedOrders     String[]  @default([])
  foundedYear        Int?
  contactEmail       String    @default("")
  linkedin           String    @default("")
  phone              String    @default("")
  address            String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("companies")
}

// ---------------------------------------------------------------------------
// Phase 2/3: website-parity hiring model. All additive; the older Swipe /
// Opportunity / Message / Task tables are left untouched.
// ---------------------------------------------------------------------------

enum PipelineStage {
  shortlisted
  contacted
  task
  interview
  hired
  rejected
}

/// One recruiter's swipe on one candidate for one job. A right swipe is a
/// shortlist and carries the pipeline stage and private notes; a left swipe
/// is a pass. Each (recruiter, candidate, job) can be swiped once.
model CandidateSwipe {
  id           String        @id @default(uuid())
  recruiterId  String
  candidateId  String
  jobPostingId String
  /// "left" (pass) | "right" (shortlist)
  action       String
  stage        PipelineStage @default(shortlisted)
  notes        String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  recruiter  User       @relation("CSwipeRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate  User       @relation("CSwipeCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, candidateId, jobPostingId])
  @@index([recruiterId, createdAt])
  @@index([candidateId, action])
  @@map("candidate_swipes")
}

/// Candidates a recruiter saved for later. Free, and independent of jobs.
model WishlistEntry {
  recruiterId String
  candidateId String
  createdAt   DateTime @default(now())

  recruiter User @relation("WishRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate User @relation("WishCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([recruiterId, candidateId])
  @@map("wishlist_entries")
}

/// A chat message between a company and a candidate. One conversation per
/// (company, candidate) pair, across all jobs. companyId is the hiring
/// account (the company owner's user id).
model ChatMessage {
  id          String    @id @default(uuid())
  companyId   String
  candidateId String
  senderId    String
  text        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  company   User @relation("ChatCompany", fields: [companyId], references: [id], onDelete: Cascade)
  candidate User @relation("ChatCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  sender    User @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([companyId, candidateId, createdAt])
  @@index([candidateId, readAt])
  @@map("chat_messages")
}

/// An interview invite with 1-3 proposed times; the candidate picks one.
model Interview {
  id            String     @id @default(uuid())
  companyId     String
  candidateId   String
  jobPostingId  String?
  slots         DateTime[]
  chosenSlot    DateTime?
  durationMins  Int        @default(30)
  /// "video" | "phone" | "in-person"
  mode          String     @default("video")
  meetingLink   String     @default("")
  location      String     @default("")
  note          String     @default("")
  /// "proposed" | "confirmed" | "cancelled"
  status        String     @default("proposed")
  cancelledById String?
  cancelReason  String     @default("")
  /// 0 = none sent, 1 = the day-before reminder went out, 2 = the hour-before one did.
  remindersSent Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company    User        @relation("InterviewCompany", fields: [companyId], references: [id], onDelete: Cascade)
  candidate  User        @relation("InterviewCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([candidateId, createdAt])
  @@map("interviews")
}

/// A take-home task sent to a shortlisted candidate (live link + GitHub repo
/// + note before a deadline).
model HiringTask {
  id                   String    @id @default(uuid())
  companyId            String
  candidateId          String
  jobPostingId         String?
  createdById          String?
  title                String
  description          String    @default("")
  briefUrl             String    @default("")
  dueAt                DateTime
  /// "assigned" | "submitted" | "cancelled"; "overdue" is computed.
  status               String    @default("assigned")
  liveUrl              String    @default("")
  repoUrl              String    @default("")
  submissionNote       String    @default("")
  submittedAt          DateTime?
  reminderSentAt       DateTime?
  reviewReminderSentAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company    User        @relation("HTaskCompany", fields: [companyId], references: [id], onDelete: Cascade)
  candidate  User        @relation("HTaskCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([candidateId, createdAt])
  @@map("hiring_tasks")
}

/// A recruiter's saved deck filter. With alerts on, a candidate who newly
/// matches triggers one notification (never twice for the same candidate).
model SavedSearch {
  id                 String   @id @default(uuid())
  recruiterId        String
  name               String
  /// { location, minExp, maxExp, maxSalary, notice: [], skills: [] }
  filters            Json
  alerts             Boolean  @default(true)
  notifiedCandidates String[] @default([])
  createdAt          DateTime @default(now())

  recruiter User @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([recruiterId, createdAt])
  @@map("saved_searches")
}

/// A swipe-credit purchase (Razorpay, or "demo" when no keys are set).
model Payment {
  id           String   @id @default(uuid())
  recruiterId  String
  planId       String
  amountRupees Int
  swipes       Int
  orderId      String   @unique
  paymentId    String?
  /// "razorpay" | "demo"
  mode         String
  /// "created" | "paid"
  status       String   @default("created")
  createdAt    DateTime @default(now())

  recruiter User @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([recruiterId, createdAt])
  @@map("payments")
}
