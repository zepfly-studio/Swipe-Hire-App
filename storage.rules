rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // A candidate's photo/resume/intro video -- only its owner can upload
    // or replace it; any signed-in account (a recruiter reviewing them)
    // can view it. Size caps are enforced here too (not just client-side
    // in CompleteProfileScreen) so a modified/direct API call can't push
    // an oversized file and run up Storage costs; intro_video gets a
    // bigger budget than the single-image/PDF slots.
    match /candidate_media/{uid}/intro_video.{ext} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                     && request.resource.size <= 50 * 1024 * 1024;
    }
    match /candidate_media/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                     && request.resource.size <= 5 * 1024 * 1024;
    }
  }
}
