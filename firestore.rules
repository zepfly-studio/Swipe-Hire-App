rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Each account's own profile -- the role recorded here decides which
    // home screen AuthGate routes them to, so it must never change after
    // signup. Only the account owner may read/write it, except recruiters
    // may also read a candidate's doc (never another recruiter's) to look
    // them up by email for the hiring pipeline.
    match /users/{uid} {
      allow read: if isSignedIn()
                   && (request.auth.uid == uid || (myRole() == 'recruiter' && resource.data.role == 'candidate'));
      allow create: if isSignedIn()
                     && request.auth.uid == uid
                     && request.resource.data.role in ['recruiter', 'candidate'];
      allow update: if isSignedIn()
                     && request.auth.uid == uid
                     && request.resource.data.role == resource.data.role;
      // Account deletion (AuthService.deleteAccount) -- only the owner.
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // The recruiter-facing swipe deck: only recruiter accounts can browse
    // or edit it.
    match /candidates/{candidateId} {
      allow read, write: if isSignedIn() && myRole() == 'recruiter';
    }

    // A candidate account's own hiring profile (age, skills, expected CTC,
    // resume/video, etc.), filled in on CompleteProfileScreen. Its owner
    // can read/write it; recruiters can read any candidate's (that's what
    // populates the swipe deck) but never write one.
    match /candidate_profiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || myRole() == 'recruiter');
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // A candidate's bookmarked job postings -- fully private to its owner.
    match /candidate_profiles/{uid}/saved_jobs/{jobPostingId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // A role a recruiter is hiring for. Any signed-in account can read
    // postings (candidates browse them); only the recruiter who created
    // one can edit or close it.
    match /job_postings/{jobPostingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                     && myRole() == 'recruiter'
                     && request.resource.data.recruiterUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.recruiterUid == request.auth.uid;
    }

    // One recruiter's hiring interaction with one candidate -- status,
    // interview schedule, offer. The candidate can only read their own;
    // the recruiter who created it can read/update it, but can never
    // reassign it to a different candidate or recruiter. A candidate may
    // also create one themselves by applying to a job_posting (status
    // "applied", recruiterUid cross-checked against that posting's real
    // owner so they can't fabricate who it's addressed to).
    match /opportunities/{opportunityId} {
      allow read: if isSignedIn()
                   && (resource.data.candidateUid == request.auth.uid || resource.data.recruiterUid == request.auth.uid);
      allow create: if isSignedIn()
                     && (
                       (myRole() == 'recruiter' && request.resource.data.recruiterUid == request.auth.uid)
                       || (
                         myRole() == 'candidate'
                         && request.resource.data.candidateUid == request.auth.uid
                         && request.resource.data.status == 'applied'
                         && request.resource.data.jobPostingId is string
                         && request.resource.data.jobPostingId != ''
                         && request.resource.data.recruiterUid ==
                            get(/databases/$(database)/documents/job_postings/$(request.resource.data.jobPostingId)).data.recruiterUid
                       )
                     );
      allow update: if isSignedIn()
                     && resource.data.recruiterUid == request.auth.uid
                     && request.resource.data.recruiterUid == resource.data.recruiterUid
                     && request.resource.data.candidateUid == resource.data.candidateUid;
      allow delete: if false;
    }
  }
}
